# Backend API base URL. This is the ONLY frontend env var needed now — homestay name, contact
# info, room content, etc. live in src/content/*.js instead. Razorpay's public key-id is sent
# dynamically by the backend's /api/payments/create-order response, so it doesn't need to be
# configured here either.
VITE_API_BASE_URL=http://localhost:8080/api
