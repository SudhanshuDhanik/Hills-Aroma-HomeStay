# Copy this file's values into environment variables (or an application-local.properties
# file that overrides application.properties) — never commit real secrets.

DB_URL=jdbc:mysql://localhost:3306/homestay_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

SERVER_PORT=8080

# Generate a long random string for production, e.g.: openssl rand -base64 48
JWT_SECRET=local-dev-only-change-me-this-should-be-at-least-32-chars-long
JWT_EXPIRATION_MS=86400000

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Default admin account created automatically on first run if it doesn't exist yet
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Razorpay Dashboard -> Settings -> API Keys. Use TEST keys (rzp_test_...) until you're ready
# to accept real payments, then switch to LIVE keys (rzp_live_...). The secret must stay here,
# backend-only — it is never sent to the frontend.
RAZORPAY_KEY_ID=replace_this_text_with_your_razorpay_key_id
RAZORPAY_KEY_SECRET=replace_this_text_with_your_razorpay_key_secret

# Shown on the Razorpay Checkout popup and in payment order receipts
HOMESTAY_NAME=replace this text with your homestay name
